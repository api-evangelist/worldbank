          "id": "3c5c02fd-4f26-427c-81c8-ae600ff3ce8e",
          "name": "Get indicator data for all countries",
          "request": {
            "name": "Get indicator data for all countries",
            "description": {
              "content": "Returns time series data for the specified indicator across all countries. Common indicators include SP.POP.TOTL (Population), NY.GDP.MKTP.CD (GDP), SP.DYN.IMRT.IN (Infant mortality), SE.ADT.LITR.ZS (Literacy rate).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "country",
                "all",
                "indicator",
                ":indicator_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "Date range filter. Single year (2010), range (2010:2020), or monthly (2010M01:2010M12) or quarterly (2010Q1:2010Q4).\n"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "50",
                  "description": "Records per page (max 1000)"
                },
                {
                  "disabled": false,
                  "key": "mrv",
                  "value": "<integer>",
                  "description": "Returns the most recent values for the specified number of years"
                },
                {
                  "disabled": false,
                  "key": "gap_fill",
                  "value": "<string>",
                  "description": "Fills missing values with the previous non-empty value when used with mrv"
                },
                {
                  "disabled": false,
                  "key": "frequency",
                  "value": "<string>",
                  "description": "Frequency of returned data (M=monthly, Q=quarterly, Y=yearly)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "indicator_id",
                  "description": "(Required) World Bank indicator code (e.g., SP.POP.TOTL, NY.GDP.MKTP.CD)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
