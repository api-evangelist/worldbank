  "info": {
    "_postman_id": "dcce2af5-3c3d-4734-8654-7ec53c14a37b",
    "name": "World Bank Indicators Classifications API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The World Bank Indicators API provides programmatic access to nearly 16,000 time series development indicators. These indicators include data such as total population, gross domestic product, energy use, poverty rates, health metrics, education statistics, and demographic data across countries and regions. Most data series date back over 50 years. No authentication is required. Supports filtering by date range, country, region, income level, and lending type. Returns data in JSON format with pagination support.\n\n\nContact Support:\n Name: World Bank Data Help Desk\n Email: data@worldbank.org",
      "type": "text/plain"
    }
  }
